{
  "manifest_version": 3,
  "name": "YouTube Keyword Hider",
  "version": "1.0.0",
  "description": "Hide YouTube videos whose titles contain keywords you choose.",
  "icons": {
    "16": "images/Keyword Video Filter Icon.png",
    "32": "images/Keyword Video Filter Icon.png",
    "48": "images/Keyword Video Filter Icon.png",
    "128": "images/Keyword Video Filter Icon.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "action": {
    "default_title": "YouTube Keyword Hider",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/Keyword Video Filter Icon.png",
      "32": "images/Keyword Video Filter Icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
